<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="TiendaVirtualPU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>model.jpa.ClienteJpa</class>
        <class>model.jpa.PedidoJpa</class>
        <class>model.jpa.DetallePedidoJpa</class>
        <class>model.jpa.ProductoJpa</class>
        <class>model.jpa.StockJpa</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.SQLServerDialect"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- No crear ni modificar tablas automáticamente -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

        </properties>

    </persistence-unit>

</persistence>